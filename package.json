    "gen:music": "node tools/gen-music.mjs",
    "verify:offline": "node tools/verify-offline.mjs"
  },
  "dependencies": {
    "@minit-games/sdk": "^1.10.0",
    "pixi.js": "^8.20.1"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  }
}
