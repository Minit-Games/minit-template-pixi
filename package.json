{
  "name": "minit-template-pixi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PixiJS starter template for Minit Games \u2014 fast 2D sprite work",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/check-meta.mjs",
    "preview": "vite preview",
